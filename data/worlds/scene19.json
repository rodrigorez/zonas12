      "interaction": "page",
      "title": {
        "pt": "Sin Colgar"
      },
      "authors": "Esterbel",
      "synopsis": {
        "pt": "Sin Colgar é um autorretrato audiovisual sobre hiperconectividade e esgotamento mental. Imagens de tensão, chamadas, digitação e alarmes criam uma experiência de saturação. Aos 1 minuto e 16 segundos, o silêncio interrompe o ruído como gesto de pausa, alívio e resistência."
      },
      "site": "https://drive.google.com/file/d/1sSRAEqMJperU9UqEQcALJuHpbZ6QL15S/preview"
    },
