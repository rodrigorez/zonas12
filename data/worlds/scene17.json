      "interaction": "page",
      "title": {
        "pt": "ENSAYOS DE UN CUERPO EXPANDIDO"
      },
      "authors": "Antonio Faus",
      "coAuthors": "Julián Miralles; Dani Monllor",
      "synopsis": {
        "pt": "Ensaios de um corpo expandido é uma videoperformance que entende o vestir como um ato performativo, escultórico e político. O corpo torna-se suporte vivo e matéria moldável entre têxteis, luz e movimento. Através de uma presença andrógina, a obra questiona os códigos de género e propõe o corpo como território de expressão."
      },
      "site": "https://drive.google.com/drive/u/1/folders/1a0V0nBqBx6_EyAjytNNCzCFlr8F9onZT"
    },
