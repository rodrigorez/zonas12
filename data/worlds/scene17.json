      "interaction": "page",
      "title": {
        "pt": "Circuiti"
      },
      "authors": "Diana",
      "synopsis": {
        "pt": "A obra busca circuitos e conexões por meio de imagens que se relacionam entre si. Apresenta uma narrativa abstrata que explora a dimensão da vida através de um olhar íntimo e colorido, ao ritmo da música."
      },
      "site": "https://drive.google.com/file/d/1cRQJvNryLZeJpL-1JgpzWxdAoWSiwO7H/preview"
