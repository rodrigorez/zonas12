      "interaction": "page",
      "title": {
        "pt": "encarne, encarnada"
      },
      "authors": "Marcos Boluda",
      "synopsis": {
        "pt": "“encarne, encarnada” propõe uma experiência sensorial em torno da flor. Por meio de uma imagem onírica e envolvente, a obra explora a imagem em movimento como se fosse matéria plástica para despertar emoções, transformando a fragilidade da flor em um espelho da condição humana."
      },
      "site": "https://drive.google.com/file/d/1Jksb2OUwDpJI_M_lxiAiBNp_KFF0iR1P/preview"
    },
