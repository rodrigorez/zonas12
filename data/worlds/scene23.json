      "interaction": "page",
      "title": {
        "pt": "Stoned"
      },
      "authors": "Guillermo Ros",
      "synopsis": {
        "pt": "Stoned confronta pedra e espelho para explorar as tensões entre natural e artificial, real e virtual, matéria e imagem. A pedra se desdobra em seu reflexo, diluindo o limite entre objeto físico e imagem e construindo um espaço de continuidade entre ambas as realidades."
      },
      "site": "https://imgur.com/a/CYQ8tFk"
    },
